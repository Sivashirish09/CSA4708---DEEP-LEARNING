#  real estate company develops machine learning models to predict house prices based on 
house area. A linear regression model and polynomial regression models of degrees 2 and 10 
are trained using the same dataset. The company wants to compare how model complexity 
affects prediction performance. 
Write a Python program to generate sample house-price data, train polynomial regression 
models of degrees 1, 2, and 10, and to plot their prediction curves against the actual data. 









import numpy as np
import matplotlib.pyplot as plt
from sklearn.preprocessing import PolynomialFeatures
from sklearn.linear_model import LinearRegression
from sklearn.pipeline import make_pipeline

np.random.seed(1)
X = np.linspace(1,10,30).reshape(-1,1)
y = 2*X.ravel()**2 + np.random.randn(30)*10

for d in [1,2,10]:
    model = make_pipeline(
        PolynomialFeatures(d), LinearRegression())
    model.fit(X,y)
    plt.plot(X,model.predict(X),label=f"Degree {d}")

plt.scatter(X,y)
plt.legend()
plt.show()
