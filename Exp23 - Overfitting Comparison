# deep learning research team uses a machine learning model to classify images based on 
extracted numerical features. A highly complex polynomial model performs well on training 
data but poorly on unseen testing data. 
Write a Python program to generate a sample nonlinear dataset, train polynomial regression 
models with degrees 2 and 15, calculate their training and testing errors, and to compare 
their fitted curves.





import numpy as np
from sklearn.model_selection import train_test_split
from sklearn.pipeline import make_pipeline
from sklearn.preprocessing import PolynomialFeatures
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_squared_error

np.random.seed(1)
X = np.linspace(-3,3,40).reshape(-1,1)
y = X.ravel()**2 + np.random.randn(40)*2
A,B,C,D = train_test_split(X,y,test_size=0.25,random_state=1)

for d in [2,15]:
    m = make_pipeline(PolynomialFeatures(d),LinearRegression())
    m.fit(A,C)
    print("Degree:",d,
          "Train:",mean_squared_error(C,m.predict(A)),
          "Test:",mean_squared_error(D,m.predict(B)))
