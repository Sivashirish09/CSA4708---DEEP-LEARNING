#  college develops a machine learning model to predict students’ examination marks based 
on study hours. The model uses a simple linear relationship, but the actual marks follow a 
nonlinear pattern. 
Write a Python program using to generate nonlinear student-performance data, train a linear 
regression model, calculate its training and testing mean squared errors, and to compare the 
actual marks with the predicted values.




import numpy as np
from sklearn.model_selection import train_test_split
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_squared_error

X = np.arange(1,21).reshape(-1,1)
y = X.ravel()**2

X1,X2,y1,y2 = train_test_split(
    X,y,test_size=0.2,random_state=1)

m = LinearRegression().fit(X1,y1)
print("Train MSE:", mean_squared_error(y1,m.predict(X1)))
print("Test MSE:", mean_squared_error(y2,m.predict(X2)))
