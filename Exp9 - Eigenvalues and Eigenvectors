Write a Python program to calculate the eigenvalues and eigenvectors of the covariance 
matrix, and to plot the eigenvectors as arrows from the origin in a two-dimensional 
coordinate system.



import numpy as np
import matplotlib.pyplot as plt

A = np.array([[3,1],[1,3]])
v, V = np.linalg.eig(A)
print("Eigenvalues:", v)
print("Eigenvectors:\n", V)

for i in range(2):
    plt.quiver(0,0,V[0,i],V[1,i],
               angles='xy', scale_units='xy', scale=1)
plt.xlim(-1,1)
plt.ylim(-1,1)
plt.grid()
plt.show()
