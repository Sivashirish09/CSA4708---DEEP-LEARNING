# weather forecasting team develops prediction models with different polynomial degrees 
to estimate temperature based on time-related features. The team wants to identify a suitable 
model that balances simplicity and predictive accuracy. 
Write a Python program to generate sample temperature data, train polynomial regression 
models with degrees 1, 3, and 12, calculate the training and testing mean squared errors, and 
to compare model performance. 




import numpy as np
from sklearn.pipeline import make_pipeline
from sklearn.preprocessing import PolynomialFeatures
from sklearn.linear_model import LinearRegression
from sklearn.model_selection import train_test_split
from sklearn.metrics import mean_squared_error

np.random.seed(2)
X = np.linspace(0,10,50).reshape(-1,1)
y = np.sin(X).ravel() + np.random.randn(50)*0.1
A,B,C,D = train_test_split(X,y,test_size=0.2,random_state=1)

for d in [1,3,12]:
    m = make_pipeline(PolynomialFeatures(d),LinearRegression())
    m.fit(A,C)
    print(d,mean_squared_error(C,m.predict(A)),
          mean_squared_error(D,m.predict(B)))
